<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 선택 상태 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#F26807"/> <!-- 선택된 주황색 -->
            <corners android:radius="@dimen/dimen_8"/>
        </shape>
    </item>
    <!-- 미선택 상태 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white_90"/>
            <stroke android:width="1dp" android:color="@color/white_90"/> <!-- 테두리 -->
            <corners android:radius="@dimen/dimen_8"/>
        </shape>
    </item>
</selector>