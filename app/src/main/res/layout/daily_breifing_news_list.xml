<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="564dp"
    android:layout_height="@dimen/dimen_174"
    android:paddingHorizontal="40dp">

    <ImageView
        android:id="@+id/ivNewsThumbnail"
        android:layout_width="162dp"
        android:layout_height="162dp"
        android:scaleType="centerCrop"
        android:background="@drawable/radius24"
        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tvNewsChannel"
        android:layout_width="304dp"
        android:layout_height="45dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="@dimen/dimen_8"
        android:gravity="center_vertical"
        android:textColor="@color/c_1D1D1D"
        android:textSize="@dimen/string_32sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivNewsThumbnail"/>

    <TextView
        android:id="@+id/tvNewsTitle"
        android:layout_width="304dp"
        android:layout_height="78dp"
        android:textColor="@color/c_555555"
        android:textSize="@dimen/string_28sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="@dimen/dimen_8"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@+id/tvNewsChannel"
        app:layout_constraintStart_toEndOf="@+id/ivNewsThumbnail"/>
</androidx.constraintlayout.widget.ConstraintLayout>
